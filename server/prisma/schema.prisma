generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// @section User Related Models
//

model User {
  id                          String            @id @default(uuid()) @db.Uuid
  username                    String            @unique @db.VarChar(24)
  email                       String            @unique @db.VarChar(320)
  password                    String            @db.VarChar(320)
  accountCreatedAt            DateTime          @default(now()) @map("account_created_at")
  accountLastUpdatedAt        DateTime          @updatedAt @map("account_last_updated_at")
  refreshToken                String?           @unique @map("refresh_token")
  refreshTokenCreatedAt       DateTime?         @map("refresh_token_created_at")
  refreshTokenExpiresAt       DateTime?         @map("refresh_token_expires_at")
  accountLockedUntil          DateTime?         @map("account_locked_until")

  profileDescription          String?           @map("profile_description") @db.Text
  profilePicture              String?           @map("profile_picture") @db.VarChar(255)

  /*****   Relationships   *****/  
  userAuditLog                UserAuditLog[]
  userRoles                   UserRoles[]
  creator                     Creator?
}

model UserAuditLog {
  id                          String            @id @default(uuid()) @db.Uuid

  userId                      String?           @map("user_id") @db.Uuid
  user                        User?             @relation(fields: [userId], references: [id])

  timestamp                   DateTime          @default(now())
  ipAddress                   String            @map("ip_address") @db.Inet
  actionType                  Action            @map("action_type")
  tableName                   String?           @map("table_name")
  dataIdentifer               String?           @map("data_identifier")
  oldValues                   Json?             @map("old_values")
  newValues                   Json?             @map("new_values")
}

//
// @section Course Related Models
//
// ( Course > Section > Lesson > Page > PageBlock )

model Course {
  id                          String            @id @default(uuid()) @db.Uuid

  creatorId                   String            @map("creator_id") @db.Uuid
  creator                     Creator           @relation(fields: [creatorId], references: [id])

  // Course Information
  title                       String
  description                 String
  price                       Int

  /*****   Relationships   *****/  
  sections                    Section[]
}

model Section {
  id                          String            @id @default(uuid()) @db.Uuid
  title                       String
  description                 String
  order                       Int               @default(0)

  courseId                    String            @db.Uuid
  course                      Course            @relation(fields: [courseId], references: [id])

  /*****   Relationships   *****/  
  lessons                     Lesson[]
}

model Lesson {
  id                          String            @id @default(uuid()) @db.Uuid

  sectionId                   String            @db.Uuid
  section                     Section           @relation(fields: [sectionId], references: [id])
  order                       Int               @default(0)


  title                       String
  description                 String

  /*****   Relationships   *****/  
  pages                       Page[]
}

model Page {
  id                          String            @id @default(uuid()) @db.Uuid

  lessonId                    String            @db.Uuid
  lesson                      Lesson            @relation(fields: [lessonId], references: [id])

  title                       String
  pageNumber                  Int               @map("page_number") @db.SmallInt

  /*****   Relationships   *****/  
  pageBlocks                   PageBlock[]
}


model PageBlock {
  id                          String            @id @default(uuid()) @db.Uuid

  page                        Page              @relation(fields: [pageId], references: [id])
  pageId                      String            @map("page_id") @db.Uuid

  position                    Int               @default(0)

  // Output / Static Content
  contentType                 MediaType?        @map("content_type")
  contentUrl                  String?           @map("content_url")
  contentText                 String?           @map("content_text")

  // Input Provided Content
  quiz                        Quiz?

  @@unique([pageId, position])
}

//
//  @section Special InputContents
//

model Quiz {
	id                        String              @id

  blockId                   String              @unique
  block                     PageBlock           @relation(fields: [blockId], references: [id])

	questions                 QuizQuestion[]
}

model QuizQuestion {
	id                        String              @id

	quizId                    String             
  quiz                      Quiz                @relation(fields: [quizId], references: [id])
  
	question                  String
	type                      QuestionType
  // e.g. [{answer: "answer1", correct: true, reasoning: "reasoning1"}, {answer: "answer2", correct: false, reasoning: "reasoning2"}]
	answers                   Json
}

//
//  @section Creator Related Models
//

model Creator {
  id                          String            @id @default(uuid()) @db.Uuid

  userId                      String            @map("user_id") @unique @db.Uuid
  user                        User              @relation(fields: [userId], references: [id])

  planId                      Int               @db.SmallInt @map("plan_id")
  plan                        Plan              @relation(fields: [planId], references: [id])  

  createdAt                   String            @map("created_at")

  // Payment Information
  stripeAccountId             String            @map("stripe_account_id")
  payoutEnabled               Boolean           @map("payout_enabled")  
  
  /*****   Relationships   *****/  
  courses                     Course[]
}

model Plan {
  id                          Int               @id @db.SmallInt
  name                        String

  // Payment Information
  price                       Int
  interval                    Interval          @default(MONTHLY)
  stripePriceId               String            @unique @map("stripe_price_id")

  // TODO: Permissions / Features 

  /*****   Relationships   *****/  
  creators                     Creator[]
}

model Role {
  id                          Int               @id @db.SmallInt
  name                        String   

  /*****   Relationships   *****/  
  userRoles                   UserRoles[]
}

model UserRoles {
  userId                      String            @map("user_id") @db.Uuid
  user                        User              @relation(fields: [userId], references: [id])

  roleId                      Int               @map("role_id") @db.SmallInt
  role                        Role              @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

//
// @section Enums
//

enum Action {
  LOGIN_FAILED
  LOGIN_SUCCESS
  LOGOUT
  PASSWORD_RESET
  MFA_VERIFICATION
  REFRESH_TOKEN_USAGE
  ROLE_CHANGE
}

enum Interval {
  MONTHLY
  ANNUALLY
}

enum MediaType {
  // Base 4 media types
  VIDEO
  AUDIO
  IMAGE
  PARAGRAPH
  // Additionally formatted media types
  QUOTE
  LIST
  CODE_STATEMENT // single line of code
  CODE_BLOCK // multi-line code block
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SELECT_MULTIPLE
}
